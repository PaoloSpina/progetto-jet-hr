{
  "name": "ral-netto-prototype",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev --webpack",
    "build": "node scripts/run-next.mjs build --webpack",
    "start": "next start",
    "lint": "eslint src next.config.ts eslint.config.mjs vitest.config.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "decimal.js": "10.6.0",
    "next": "16.3.3",
    "prisma": "6.16.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.3.3",
    "@next/swc-wasm-web": "^16.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "27.0.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
